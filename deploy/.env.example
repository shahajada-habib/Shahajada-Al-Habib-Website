# Copy to `.env` (which is gitignored) and fill every value.
# The quickest source for most of these is your existing Render service:
#   Render dashboard -> your service -> Environment tab.

# --- Database (Aiven managed MySQL) ---------------------------------------
# Copy these THREE verbatim from Render. The URL keeps Aiven's ?ssl-mode=REQUIRED
# (or sslMode=REQUIRED) query string exactly as it is there.
DB_URL=jdbc:mysql://HOST:PORT/DBNAME?ssl-mode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=

# --- Auth --------------------------------------------------------------------
# MUST match Render's JWT_SECRET, otherwise a token issued on one host is
# rejected by the other.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=86400

# --- URLs ------------------------------------------------------------------
# Milestone 1: use the VM's external IP. Switch to https://gcp.<domain> in M2.
SITE_URL=http://YOUR_VM_EXTERNAL_IP
CORS_ALLOWED_ORIGINS=http://YOUR_VM_EXTERNAL_IP

# --- Media -----------------------------------------------------------------
# Matches the volume mount in docker-compose.yml; leave as-is.
MEDIA_UPLOAD_DIR=/app/uploads

# --- Seeding -------------------------------------------------------------------
# Leave disabled in production; the admin user already exists in the shared DB.
SEED_DEFAULT_USERS_ENABLED=false
SEED_DEFAULT_USERS_RESET_PASSWORD=false
SEED_DEFAULT_PASSWORD=
