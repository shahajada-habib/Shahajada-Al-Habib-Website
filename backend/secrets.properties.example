# Copy this file to "secrets.properties" (same folder) and fill in your real values.
# secrets.properties is gitignored -- it will never be committed or pushed to GitHub.
# Do this once on EACH machine (office PC and home laptop) using the SAME cloud database
# details, so both machines see the same poems/articles.

# From your Aiven MySQL service page ("Overview" tab -> Connection information):
DB_URL=jdbc:mysql://<host>:<port>/defaultdb?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=<your-aiven-password>

# Change this from the default before writing real content.
SEED_DEFAULT_PASSWORD=1234
